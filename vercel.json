{
    "installCommand": "npm install",
    "buildCommand": "npm run postinstall",
    "outputDirectory": "web",
    "routes": [
        {
            "src": "^/ads-media/(.*)$",
            "headers": {
                "Access-Control-Allow-Origin": "*",
                "X-Robots-Tag": "noindex"
            },
            "continue": true
        },
        {
            "src": "^/index\\.html$",
            "status": 308,
            "headers": {
                "Location": "/"
            }
        },
        {
            "src": "^/scuttle/index\\.html$",
            "status": 308,
            "headers": {
                "Location": "/scuttle/"
            }
        },
        {
            "src": "^/scuttle$",
            "status": 308,
            "headers": {
                "Location": "/scuttle/"
            }
        },
        {
            "src": "^/scuttle/privacy$",
            "status": 308,
            "headers": {
                "Location": "/scuttle/privacy.html"
            }
        },
        {
            "src": "^/SCUTTLE/?$",
            "status": 308,
            "headers": {
                "Location": "/scuttle/"
            },
            "caseSensitive": true
        },
        {
            "handle": "filesystem"
        },
        {
            "src": "/(.*)",
            "status": 404,
            "dest": "/404.html"
        }
    ]
}
